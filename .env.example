# .env.example
# A template with NO real secrets. This file is safe to share or commit.
# To use it: copy this file to ".env" and fill in the real values.

# ---- App ----
APP_NAME="Holiday Talent Program"
BASE_URL=/talent-program
APP_TIMEZONE=Africa/Nairobi

# true while developing, ALWAYS false on the live server
APP_DEBUG=true

# ---- Database ----
DB_HOST=localhost
DB_NAME=talent_program
DB_USER=
DB_PASS=

# ---- Business rules ----
REGISTRATION_FEE=2000
