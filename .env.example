# .env.example
# A template with NO real secrets. Copy this file to ".env" and fill in the real values.

# ---- App ----
APP_NAME="Holiday Talent Program"
# URL path where the app lives, no trailing slash. Must match the real URL path exactly
# (session cookies are tied to it). Use an empty value if the app is at the domain root.
BASE_URL=/talent_program
APP_TIMEZONE=Africa/Nairobi

# true while developing, ALWAYS false on the live server
APP_DEBUG=true

# Set true only if the site sits behind a trusted proxy/load balancer that sets X-Forwarded-For
TRUSTED_PROXY=false

# ---- Database ----
DB_HOST=localhost
DB_NAME=talent_program
DB_USER=
DB_PASS=

# ---- Business rules ----
REGISTRATION_FEE=2000

# ---- M-Pesa (Safaricom Daraja) ----
# simulate = no network, fake success after ~5s (only works while APP_DEBUG=true)
# sandbox  = Safaricom test server, with your sandbox app keys
# live     = real money, with your production keys
MPESA_MODE=simulate

# From https://developer.safaricom.co.ke  (your app's keys). Leave empty while simulating.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number when using CustomerBuyGoodsOnline (defaults to MPESA_SHORTCODE)
MPESA_PARTY_B=

# The PUBLIC https address of api/mpesa_callback.php, reachable from the internet
MPESA_CALLBACK_URL=https://your-domain.example/talent_program/api/mpesa_callback.php
# A long random string, e.g. generate one with:  php -r "echo bin2hex(random_bytes(24));"
# The token is appended to the callback URL; callbacks without it are rejected.
MPESA_CALLBACK_SECRET=
